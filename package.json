{
  "name": "logvar-player",
  "version": "13.0.0",
  "description": "环影 - Jellyfin + 本地文件 + 弹幕",
  "main": "./out/main/main.js",
  "author": "环影",
  "license": "MIT",
  "scripts": {
    "prepare:icons": "node scripts/make-transparent-icons.mjs",
    "predev": "npm run prepare:icons",
    "dev": "electron-vite dev --config electron.vite.config.cts",
    "prebuild": "npm run prepare:icons",
    "build": "electron-vite build --config electron.vite.config.cts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepreview": "npm run prepare:icons",
    "preview": "electron-vite preview --config electron.vite.config.cts",
    "start": "node launcher.cjs",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config",
    "build:unpack": "npm run build && electron-builder --win --dir --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.62.0",
    "framer-motion": "^12.40.0",
    "koffi": "^3.0.2",
    "lucide-react": "^1.17.0",
    "node-mpv": "2.0.0-beta.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "electron": "^33.0.0",
    "electron-builder": "^25.4.0",
    "electron-vite": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
